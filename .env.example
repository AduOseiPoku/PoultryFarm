# ==============================================================================
# Poultry Farm Monitoring - Production Environment Variables
# ==============================================================================

# Django Secret Key (generate a strong random string for production)
SECRET_KEY=generate-a-strong-random-secret-key-here

# Debug mode (ALWAYS False in production)
DEBUG=False

# Allowed hostnames (comma-separated, no spaces)
# e.g., poultry.yourdomain.com,127.0.0.1
ALLOWED_HOSTS=poultry.yourdomain.com

# CSRF Trusted Origins (required by Django 4+ when deployed behind HTTPS / Dokploy Traefik)
# Comma-separated list with https:// scheme included
CSRF_TRUSTED_ORIGINS=https://poultry.yourdomain.com

# Database URL (Optional: Leave empty if using SQLite with persistent volume)
# If using Dokploy PostgreSQL, paste connection string here:
# postgresql://postgres:password@postgres:5432/poultryfarm
# DATABASE_URL=

# Directory for SQLite database file if not using PostgreSQL (mapped to persistent volume)
DATA_DIR=/app/data

# Gunicorn configuration
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
